{
  "name": "poornas-kitchen-desktop",
  "productName": "Poorna's Kitchen",
  "version": "1.1.0",
  "description": "Poorna's Kitchen — bookings, orders, billing, stock and P&L",
  "main": "main.js",
  "author": "Poorna's Kitchen",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "in.poornaskitchen.app",
    "productName": "Poorna's Kitchen",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app-settings.json",
      "www/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "artifactName": "Poornas-Kitchen-Mac.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Poornas-Kitchen-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Poorna's Kitchen",
      "artifactName": "Poornas-Kitchen-Windows-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}